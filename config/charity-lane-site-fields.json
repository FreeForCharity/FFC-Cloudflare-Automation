{
  "_comment": "Allowlist for workflow 234 (scripts/whmcs-charity-lane-site-fields.ps1): the ONLY WHMCS fields it may emit, each one a field the charity's application collects FOR PUBLICATION on its website. Output is printed to a public job log and issue, so a field not listed here is never emitted, whatever WHMCS holds. Per field: `key` (output name), `clientField` (Custom Client Field name, as in config/whmcs-client-field-populate-map.json values), `productFields` (product custom-field machine-names on pid 16/33/40, as in that map's keys; tried when the client field is empty or invalid), optional `productLabelPatterns` (case-insensitive regexes over the answer's display label, which is what GetClientsProducts actually returns for pid 16/33 questions; the label is HTML-decoded and loses a trailing \"(optional)\" first; tried after the machine-names), and `type` (the validator). The loader refuses any entry that names a personal or board field (see `deniedNamePatterns`), so adding one is a reviewed change that fails its own tests. Never add: the mailing address, the applicant's or any contact's name/email/phone, board/officer/team-member fields, testimonial attributions.",
  "version": 1,
  "productIds": [16, 33, 40],
  "excludedServiceStatuses": ["Cancelled", "Terminated", "Fraud"],
  "deniedNamePatterns": [
    "mailing",
    "address",
    "contact",
    "board",
    "officer",
    "president",
    "treasurer",
    "secretary",
    "chair",
    "director",
    "team",
    "testimonial",
    "individual",
    "personal",
    "your name",
    "first name",
    "last name",
    "full name"
  ],
  "fields": [
    {
      "key": "publicEmail",
      "clientField": "Public email (website footer)",
      "productFields": ["public-email"],
      "productLabelPatterns": ["^public e-?mail( address)? for your website footer$"],
      "type": "email",
      "maxLength": 254
    },
    {
      "key": "publicPhone",
      "clientField": "Public phone (website footer)",
      "productFields": ["public-phone"],
      "productLabelPatterns": ["^public phone( number)? for your website footer$"],
