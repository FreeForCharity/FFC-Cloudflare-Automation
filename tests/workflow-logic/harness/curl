#!/usr/bin/env bash
# Fake `curl` for workflow-logic tests. Behavior is driven by TEST_* env vars;
# every invocation is appended to $TEST_CURL_LOG so tests can assert on probes.
#
# Two shapes are simulated, matching the preflight probes:
#   - default-Pages-URL probe (`-o /dev/null -w '%{http_code}'` against github.io)
#     -> prints TEST_PAGES_CODE (default 404)
#   - default-Pages-URL BODY fetch (same URL, no -w) -> prints TEST_PAGES_BODY.
#     702 reads the served <title> to tell 720's template seed from a completed
#     migration (#1538), so the two github.io shapes must be answerable apart;
#     they are distinguished on `%{http_code}` being asked for, not on the URL.
#     The default body is the seed's title, which is what every freshly created
#     FFC-EX repo really serves.
#   - header probe (`-sSIL` against the live domain)
#     -> prints status line + Server header from TEST_APEX_CODE / TEST_APEX_SERVER
#     TEST_APEX_UNRESOLVED=1 prints NOTHING and exits non-zero, which is what curl
#     does for a domain with no DNS at all -- the pre-cutover state, and the one
#     the old probe-failure guard could not tell from a network fault.

if [ -n "${TEST_CURL_LOG:-}" ]; then
  printf '%s\n' "$*" >> "$TEST_CURL_LOG"
fi

url=""
for a in "$@"; do
  case "$a" in
    http://*|https://*) url="$a" ;;
  esac
done

case "$url" in
  *github.io*)
    # `-w '%{http_code}'` is present only on the status probe.
    if printf '%s' "$*" | grep -q 'http_code'; then
      printf '%s' "${TEST_PAGES_CODE:-404}"
    else
      printf '%s' "${TEST_PAGES_BODY-<html><head><title>Free For Charity | Reduce Costs, Increase Impact</title></head></html>}"
    fi
    ;;
  *)
    if [ "${TEST_APEX_UNRESOLVED:-}" = "1" ]; then
      echo "curl: (6) Could not resolve host" >&2
      exit 6
    fi
    if [ "${TEST_APEX_NO_SERVER:-}" = "1" ]; then
      printf 'HTTP/2 %s\r\n' "${TEST_APEX_CODE:-200}"
    else
      printf 'HTTP/2 %s\r\nserver: %s\r\n' "${TEST_APEX_CODE:-200}" "${TEST_APEX_SERVER:-cloudflare}"
    fi
    ;;
esac
