{
  "_comment": "Gate policy for the charity-lane pipeline (docs/charity-lane-pipeline.md, epic #1618). scripts/charity_lane_gate.py is the ONLY path by which the Onboarding Conductor clears an environment gate: it validates a dispatch against one rule below, dispatches it itself, and approves only that run, only for the rule's environments. Inputs are a closed set: an input not listed under a rule is refused. Changing this file changes what an unattended agent may approve, so it is a policy change for Clarke. The same script also runs inside workflow 753 (environment charity-lane-broker, docs/charity-intake-autonomy.md), so these rules are exactly what GitHub Actions itself may approve with no agent session and no operator present; `advance` and `sequences` below are the unattended loops 753 runs on its schedules.",
  "repo": "FreeForCharity/FFC-Cloudflare-Automation",
  "ref": "main",
  "ledger_issue": 1608,
  "advance": {
    "_comment": "Gate 1/2 loop: run the verdicts rule, then accept each ACCEPT row whose own fraud_check is pass, oldest order first, through 226-approve-one (gate 1) or 211-accept-one (gate 2). At most max_accepts per run (the testing-period limit in docs/charity-lane-pipeline.md).",
    "verdicts_rule": "232-verdicts",
    "verdicts_artifact": "charity-lane-verdicts",
    "max_accepts": 3
  },
  "sequences": {
    "weekly-sites-list": [
      { "rule": "601-export", "inputs": {} },
      { "rule": "703-generate", "inputs": { "prime_wpmudev": "false" } }
    ]
  },
  "never": [
    "211 cancel or fraud",
    "226 reconcile or reconcile-report, or approve with more than one order id",
    "113 domain register (spends money)",
    "120 with DNS (skip_dns=false), more than one domain, or for a domain serving a live site",
    "accepting a pid 39 / 41 domain order",
    "any m365-prod write",
    "any run this script did not dispatch"
  ],
  "rules": [
    {
      "id": "226-report",
      "workflow": "226-whmcs-application-triage.yml",
      "environments": ["whmcs-prod"],
      "required": ["mode"],
      "inputs": {
        "mode": { "enum": ["report"] }
      }
    },
    {
      "id": "226-approve-one",
      "purpose": "Gate 1: accept one pid 16/33 onboarding order whose charity-lane verdict is ACCEPT",
      "workflow": "226-whmcs-application-triage.yml",
      "environments": ["whmcs-prod"],
      "required": ["mode", "orderids"],
      "inputs": {
        "mode": { "enum": ["approve"] },
        "orderids": { "pattern": "^[0-9]{1,9}$" }
      }
    },
    {
      "id": "211-accept-one",
      "purpose": "Gate 2: accept one pid 40 website order whose referenced onboarding service is Active",
      "workflow": "211-whmcs-order-update.yml",
      "environments": ["whmcs-prod"],
      "required": ["order_id", "action"],
      "inputs": {
        "order_id": { "pattern": "^[0-9]{1,9}$" },
        "action": { "enum": ["accept"] },
        "reason": { "maxlen": 200 },
        "dry_run": { "enum": ["true", "false"] }
      }
    },
    {
      "id": "205-templated",
      "purpose": "Charity tickets from an allowlisted template only (onboarding_need_info, preview_ready)",
      "workflow": "205-whmcs-ticket-open.yml",
      "environments": ["whmcs-prod"],
      "required": ["template", "client_id", "extra_message"],
      "inputs": {
        "template": { "enum": ["onboarding_need_info", "preview_ready"] },
        "client_id": { "pattern": "^[0-9]{1,9}$" },
        "extra_message": { "maxlen": 1500 },
        "deptid": { "pattern": "^[0-9]{1,3}$" },
        "subject": { "maxlen": 150 },
        "message": { "maxlen": 2000 },
        "priority": { "enum": ["Low", "Medium"] },
        "dry_run": { "enum": ["true", "false"] }
      }
    },
    {
      "id": "701-provision",
      "purpose": "Gate 3: provision FFC-EX-<domain> and publish on the default Pages URL",
      "workflow": "701-website-provision.yml",
      "environments": ["github-prod", "cloudflare-prod-write"],
      "live_site_check": ["cloudflare-prod-write"],
      "required": ["domain"],
      "inputs": {
        "domain": {
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$"
        },
        "dry_run": { "enum": ["true", "false"] },
        "template_repo": {
          "enum": [
            "FreeForCharity/FFC-IN-Footer_Only_Template",
            "FreeForCharity/FFC-IN-FFC_Single_Page_Template"
          ]
        },
        "skip_dns": { "enum": ["true", "false"] },
        "charity_name": { "maxlen": 200 },
        "footer_email": { "maxlen": 200 },
        "footer_phone": { "maxlen": 50 },
        "footer_address": { "maxlen": 300 },
        "footer_ein": { "pattern": "^([0-9]{2}-?[0-9]{7})?$" },
        "irs_status": { "enum": ["501(c)(3) (approved)", "Not yet / pending (pre-501(c)(3))"] },
        "guidestar_profile_url": { "maxlen": 300 },
        "guidestar_direct_profile_url": { "maxlen": 300 },
        "website_situation": {
          "enum": [
            "New charity domain name and new charity website",
            "New charity domain name but existing charity site (Wix / Squarespace / etc)",
            "Existing domain name and existing website (WordPress / formal hosting)"
          ]
        },
        "current_website_url": { "maxlen": 300 },
        "domain_registrar": {
          "enum": [
            "Unknown / not sure",
            "Already with Free For Charity (eNom or Cloudflare)",
            "Wix",
            "Squarespace",
            "GoDaddy",
            "Other / another registrar",
            "No domain yet"
          ]
        },
        "requester_github_username": {
          "pattern": "^([A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38})?$"
        },
        "technical_poc_github_username": {
          "pattern": "^([A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38})?$"
        },
        "social_links": { "maxlen": 1000 },
        "leadership_lines": { "maxlen": 1000 },
        "mission": { "maxlen": 2000 },
        "donation_url": { "maxlen": 300 },
        "volunteer_url": { "maxlen": 300 }
      }
    },
    {
      "id": "103-pages-apex",
      "purpose": "Gate 4: GitHub Pages apex + www records on a brand-new domain with no live site",
      "workflow": "103-enforce-domain-standard.yml",
      "environments": ["cloudflare-prod-write"],
      "live_site_check": ["cloudflare-prod-write"],
      "required": ["domain", "github_pages_only"],
      "inputs": {
        "domain": {
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$"
        },
        "dry_run": { "enum": ["true", "false"] },
        "github_pages_only": { "enum": ["true"] },
        "manage_m365": { "enum": ["false"] },
        "issue_number": { "pattern": "^[0-9]{1,6}$" }
      }
    },
    {
      "id": "707-content-apply",
      "purpose": "Gate 3: deliver worker-built content into the charity's FFC-EX repo as a PR (707 refuses non-allowlisted paths itself)",
      "workflow": "707-website-content-apply.yml",
      "environments": ["github-prod"],
      "required": ["target_repo", "content_json"],
      "inputs": {
        "target_repo": { "pattern": "^FFC-EX-[a-z0-9.-]{3,100}$" },
        "content_json": { "maxlen": 61440 },
        "title": { "maxlen": 200 },
        "issue_url": {
          "pattern": "^(https://github\\.com/FreeForCharity/[A-Za-z0-9._-]+/issues/[0-9]+)?$"
        },
        "auto_merge": { "enum": ["true", "false"] },
        "land_when_green": { "enum": ["true", "false"] },
        "land_wait_minutes": { "pattern": "^([1-9]|[12][0-9]|30)$" },
        "dry_run": { "enum": ["true", "false"] }
      }
    },
    {
      "id": "120-cname-new-domain",
      "purpose": "Gate 4: point one brand-new domain's FFC-EX repo at its apex (public/CNAME only; DNS was set by 103). The live-site check must pass first.",
      "workflow": "120-bulk-cutover-to-github-pages.yml",
      "environments": ["github-prod"],
      "live_site_check": ["github-prod"],
      "required": ["domains", "skip_dns"],
      "inputs": {
        "domains": {
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$"
        },
        "skip_dns": { "enum": ["true"] },
        "skip_cname": { "enum": ["false"] },
        "dry_run": { "enum": ["true", "false"] }
      }
    },
    {
      "id": "751-overrides-sync",
      "purpose": "Gate 3: open one PR syncing an in-flight site's security overrides to its template when the CI row fails on the audit (751 never merges)",
      "workflow": "751-website-security-overrides-sync.yml",
      "environments": ["github-prod"],
      "required": ["target_repos"],
      "inputs": {
        "target_repos": { "pattern": "^FFC-EX-[a-z0-9.-]{3,100}$" },
        "dry_run": { "enum": ["true", "false"] }
      }
    },
    {
      "id": "232-verdicts",
      "purpose": "Gate 1/2 input: the read-only verdicts run that `advance` reads (ungated; listed so the broker may dispatch it)",
      "workflow": "232-whmcs-charity-lane-verdicts.yml",
      "environments": [],
      "required": [],
      "inputs": {
        "fraud_order_id_field": { "enum": ["ordernum", "id"] },
        "issue_number": { "pattern": "^[0-9]{0,6}$" }
      }
    },
    {
      "id": "601-export",
      "purpose": "Weekly sites list, step 1: refresh the read-only WPMUDEV export that 703 consumes (gated only because wpmudev-prod carries a reviewer)",
      "workflow": "601-wpmudev-export-sites.yml",
      "environments": ["wpmudev-prod"],
      "required": [],
      "inputs": {
        "output_file": { "enum": ["wpmudev_domains.csv"] }
      }
    },
    {
      "id": "703-generate",
      "purpose": "Weekly sites list, step 2: regenerate the list and open the data PR (a PR, so the merge queue still reviews it)",
      "workflow": "703-sites-list-generate.yml",
      "environments": ["github-prod"],
      "required": ["prime_wpmudev"],
      "inputs": {
        "prime_wpmudev": { "enum": ["false"] }
      }
    }
  ]
}
